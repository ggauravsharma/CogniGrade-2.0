SECRET_KEY=

POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=classroom

# Host is the compose SERVICE NAME, not localhost: inside a container
# localhost is the container itself. Use localhost only when running the
# backend directly on the host machine.
DATABASE_URL=postgresql+asyncpg://myuser:mypassword@postgres:5432/classroom
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
# Echo every SQL statement WITH its bound parameters. Leave false outside
# local debugging: the parameters include answer text and grading reasons.
DATABASE_ECHO=false

CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//

# The Gemini credential. ONE key, this name. Live validation found a
# deployment holding a valid key under GEMINI_API_KEY while the code read only
# GEMINI_API_KEY_1, so the container authenticated with nothing.
GEMINI_API_KEY=
# Legacy fallback, read only when GEMINI_API_KEY is unset. Extra numbered keys
# are NOT rotation: the SDK sets one module-global key, so only the first was
# ever used.
# GEMINI_API_KEY_1=

# Google sign-in. OPTIONAL, but ALL THREE are needed together: the app treats
# Google sign-in as enabled only when all three are set, and refuses the route
# otherwise instead of redirecting to Google and getting `401 invalid_client`.
# Leaving all three blank disables Google sign-in; email and password login is
# unaffected either way.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The callback Google returns the browser to. Must match a redirect URI
# registered on the OAuth client in Google Cloud Console EXACTLY, including
# scheme, host, port and path.
#
# It is configured rather than derived because nginx rewrites `^/api/(.*)$` to
# `/$1` before proxying, so the backend never sees the `/api` prefix the
# browser used and could only generate a path that is not reachable from
# outside.
#
#   docker compose (nginx on :80)   http://localhost/api/auth/google
#   backend run directly on :8000   http://localhost:8000/auth/google
#   deployed behind TLS             https://your-domain/api/auth/google
GOOGLE_REDIRECT_URI=
SMTP_SERVER=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=